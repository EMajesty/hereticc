+fn inspect_process_context() -> ProcessContext {
+    let executable_identity = match std::fs::read_link("/proc/self/exe") {
+        Ok(path) if path == Path::new(EXPECTED_EXECUTABLE) => ExecutableIdentity::Expected,
+        Ok(path) if path.to_str().is_some() => ExecutableIdentity::Unexpected,
+        _ => ExecutableIdentity::Unreadable,
+    };
+    let maps = read_bounded_maps();
+    let (mappings_readable, expected_mapping_count) =
+        match maps.as_deref().and_then(count_expected_executable_mappings) {
+            Some(count) => (true, count),
+            None => (false, 0),
+        };
+    // SAFETY: these libc calls take no pointers and have no preconditions.
+    let pid = unsafe { libc::getpid() }.cast_unsigned();
+    // SAFETY: as above.
+    let parent_pid = unsafe { libc::getppid() }.cast_unsigned();
+    ProcessContext {
+        pid,
+        parent_pid,
+        executable_identity,
+        expected_executable_mapped: expected_mapping_count != 0,
+        mappings_readable,
+        expected_mapping_count,
+    }
+}
+
+fn read_bounded_maps() -> Option<String> {
+    let file = std::fs::File::open("/proc/self/maps").ok()?;
+    let mut bytes = Vec::with_capacity(4096);
+    file.take(PROCESS_MAPS_LIMIT + 1)
+        .read_to_end(&mut bytes)
+        .ok()?;
+    if bytes.len() as u64 > PROCESS_MAPS_LIMIT {
+        return None;
+    }
+    String::from_utf8(bytes).ok()
+}
+
+fn count_expected_executable_mappings(maps: &str) -> Option<u8> {
+    let mut count = 0_u8;
+    for line in maps.lines() {
+        let mut fields = line.split_ascii_whitespace();
+        let range = fields.next()?;
+        let (low, high) = range.split_once('-')?;
+        usize::from_str_radix(low, 16).ok()?;
+        usize::from_str_radix(high, 16).ok()?;
+        let permissions = fields.next()?;
+        if permissions.len() != 4 {
+            return None;
+        }
+        let _offset = fields.next()?;
+        let _device = fields.next()?;
+        let _inode = fields.next()?;
+        let path_first = fields.next();
+        let path_second = fields.next();
+        let no_trailing_field = fields.next().is_none();
+        if permissions.as_bytes().get(2) == Some(&b'x')
+            && path_first == Some("/usr/bin/MPC")
+            && path_second == Some("Sample")
+            && no_trailing_field
+        {
+            count = count.saturating_add(1);
+        }
+    }
+    Some(count)
 }
 
