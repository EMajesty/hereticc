diff --git a/src/probe.rs b/src/probe.rs
new file mode 100644
index 0000000..e1ba7de
--- /dev/null
+++ b/src/probe.rs
@@ -0,0 +1,196 @@
+//! Read-only firmware compatibility probe.
+//!
+//! This module is available only with `probe-only`. It discovers and reads the
+//! stock image but contains no hook installation, audio interposition, memory
+//! protection, executable allocation, or firmware write path.
+
+use crate::image::{self, Firmware};
+
+/// Exact number of instruction fingerprints in the pinned firmware table.
+pub const FINGERPRINT_WORDS: usize = 63;
+/// Probe-only mode has no path that can activate a feature hook.
+pub const FEATURE_HOOKS_AVAILABLE: bool = false;
+
+/// Final compatibility classification.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ProbeStatus {
+    /// The stock application image was not found.
+    MissingImage,
+    /// One expected word could not be read.
+    Unreadable,
+    /// One readable word did not match.
+    Mismatch,
+    /// The patched SDK table no longer has the reviewed size.
+    TableSizeMismatch,
+    /// Every reviewed fingerprint matched.
+    Compatible,
+}
+
+/// Bounded compatibility result. It contains no address or firmware bytes.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct ProbeResult {
+    /// Final status.
+    pub status: ProbeStatus,
+    /// Words successfully read, including a readable mismatching word.
+    pub checked: usize,
+    /// Reviewed table size.
+    pub expected: usize,
+}
+
+impl ProbeResult {
+    const fn missing() -> Self {
+        Self {
+            status: ProbeStatus::MissingImage,
+            checked: 0,
+            expected: FINGERPRINT_WORDS,
+        }
+    }
+}
+
+/// Verify one candidate with a caller-supplied read-only word reader.
+///
+/// This is the verification implementation used by both host fixtures and the
+/// device process. The reader returns `None` when a word is unreadable.
+#[must_use]
+pub fn verify_with(base: usize, mut read_word: impl FnMut(usize) -> Option<u32>) -> ProbeResult {
+    if crate::firmware::fingerprints().count() != FINGERPRINT_WORDS {
+        return ProbeResult {
+            status: ProbeStatus::TableSizeMismatch,
+            checked: 0,
+            expected: FINGERPRINT_WORDS,
+        };
+    }
+
+    let mut checked = 0;
+    for (offset, expected) in crate::firmware::fingerprints() {
+        let Some(address) = base.checked_add(offset) else {
+            return ProbeResult {
+                status: ProbeStatus::Unreadable,
+                checked,
+                expected: FINGERPRINT_WORDS,
+            };
+        };
+        let Some(actual) = read_word(address) else {
+            return ProbeResult {
+                status: ProbeStatus::Unreadable,
+                checked,
+                expected: FINGERPRINT_WORDS,
+            };
+        };
+        checked += 1;
+        if actual != expected {
+            return ProbeResult {
+                status: ProbeStatus::Mismatch,
+                checked,
+                expected: FINGERPRINT_WORDS,
+            };
+        }
+    }
+    ProbeResult {
+        status: ProbeStatus::Compatible,
+        checked,
+        expected: FINGERPRINT_WORDS,
+    }
+}
+
+/// Discover and verify with injected, read-only host fixtures.
+#[must_use]
+pub fn inspect_with(
+    find_base: impl FnOnce() -> Option<usize>,
+    read_word: impl FnMut(usize) -> Option<u32>,
+) -> ProbeResult {
+    find_base().map_or_else(ProbeResult::missing, |base| verify_with(base, read_word))
+}
+
+/// Discover and verify the loaded stock application.
+///
+/// The process-global firmware base is published only after all 63 words match.
+#[must_use]
+pub fn inspect_process() -> ProbeResult {
+    let Some(firmware) = Firmware::find() else {
+        return ProbeResult::missing();
+    };
+    let result = verify_with(firmware.base(), image::read_u32);
+    if result.status == ProbeStatus::Compatible {
+        // SAFETY: every reviewed word in this exact image has matched, and the
+        // main executable remains loaded for the process lifetime.
+        unsafe { image::set_base(firmware.base()) };
+    }
+    result
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{
+        FEATURE_HOOKS_AVAILABLE, FINGERPRINT_WORDS, ProbeStatus, inspect_with, verify_with,
+    };
+
+    const BASE: usize = 0x4000_0000;
+
+    fn fixture() -> Vec<(usize, u32)> {
+        crate::firmware::fingerprints()
+            .map(|(offset, word)| (BASE + offset, word))
+            .collect()
+    }
+
+    fn read_from(words: &[(usize, u32)], address: usize) -> Option<u32> {
+        words
+            .iter()
+            .find_map(|(candidate, word)| (*candidate == address).then_some(*word))
+    }
+
+    #[test]
+    fn all_63_expected_words_match() {
+        let words = fixture();
+        assert_eq!(words.len(), FINGERPRINT_WORDS);
+        let result = verify_with(BASE, |address| read_from(&words, address));
+        assert_eq!(result.status, ProbeStatus::Compatible);
+        assert_eq!(result.checked, FINGERPRINT_WORDS);
+    }
+
+    #[test]
+    fn one_altered_word_is_rejected() {
+        let mut words = fixture();
+        words[20].1 ^= 1;
+        assert_eq!(
+            verify_with(BASE, |address| read_from(&words, address)).status,
+            ProbeStatus::Mismatch
+        );
+    }
+
+    #[test]
+    fn one_unreadable_word_is_rejected() {
+        let mut words = fixture();
+        words.remove(20);
+        let result = verify_with(BASE, |address| read_from(&words, address));
+        assert_eq!(result.status, ProbeStatus::Unreadable);
+        assert_eq!(result.checked, 20);
+    }
+
+    #[test]
+    fn unsupported_zero_image_is_rejected() {
+        let result = verify_with(BASE, |_| Some(0));
+        assert_eq!(result.status, ProbeStatus::Mismatch);
+        assert_eq!(result.checked, 1);
+    }
+
+    #[test]
+    fn missing_stock_image_is_explicit() {
+        let result = inspect_with(|| None, |_| panic!("missing image must not be read"));
+        assert_eq!(result.status, ProbeStatus::MissingImage);
+        assert_eq!(result.checked, 0);
+    }
+
+    #[test]
+    fn repeated_verification_is_deterministic() {
+        let words = fixture();
+        let first = verify_with(BASE, |address| read_from(&words, address));
+        let second = verify_with(BASE, |address| read_from(&words, address));
+        assert_eq!(first, second);
+    }
+
+    #[test]
+    fn probe_mode_cannot_activate_feature_hooks() {
+        const { assert!(!FEATURE_HOOKS_AVAILABLE) };
+    }
+}
