+++ b/src/selective_input.rs
@@ -0,0 +1,43 @@
+//! Probe-only access to the one reviewed encoder-dispatch branch site.
+//!
+//! This module deliberately exposes no table or arbitrary-offset installer.
+
+use crate::{hook, image};
+
+/// Prepare only the firmware's DATA encoder hook.
+///
+/// The stock instruction is not modified until [`commit`] is called.
+///
+/// # Safety
+///
+/// The firmware base must have been published by the complete probe verifier,
+/// and `handler` must use `unsafe extern "C" fn(usize, i32)`.
+#[must_use]
+pub unsafe fn prepare_data(handler: usize) -> Option<usize> {
+    let base = image::base();
+    if base == 0 {
+        return None;
+    }
+    // SAFETY: the only offset is the fingerprinted DATA site; caller supplies its ABI.
+    unsafe { hook::prepare(base, crate::firmware::DATA_HOOK.offset, handler) }
+}
+
+/// Seal prepared private pages without modifying stock text.
+#[must_use]
+pub fn seal() -> bool {
+    hook::seal()
+}
+
+/// Attempt to publish the selected stock-text branch.
+#[must_use]
+pub fn publish() -> bool {
+    hook::publish()
+}
+
+/// Release preparation state when no branch has been published.
+pub fn abort() {
+    hook::abort();
+}
+
+/// Whether publication or failed rollback may have left a live branch.
+#[must_use]
+pub fn touched() -> bool {
+    hook::touched()
+}
