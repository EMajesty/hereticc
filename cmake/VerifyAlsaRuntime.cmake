if(NOT DEFINED NEUROGENIC_EXECUTABLE)
  message(FATAL_ERROR "NEUROGENIC_EXECUTABLE is required")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E env --unset=LD_LIBRARY_PATH ldd "${NEUROGENIC_EXECUTABLE}"
  RESULT_VARIABLE ldd_status OUTPUT_VARIABLE ldd_output ERROR_VARIABLE ldd_error)
if(NOT ldd_status EQUAL 0)
  message(FATAL_ERROR "ldd failed: ${ldd_error}")
endif()
if(NOT ldd_output MATCHES "libasound\\.so")
  message(FATAL_ERROR "NEUROGENIC has no retained ALSA runtime dependency:\n${ldd_output}")
endif()
if(ldd_output MATCHES "libasound\\.so[^\n]*not found")
  message(FATAL_ERROR "NEUROGENIC cannot resolve ALSA without LD_LIBRARY_PATH:\n${ldd_output}")
endif()
