[Unit]
Description=NEUROGENIC standalone workstation
After=graphical-session.target sound.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
ExecStart=%h/.local/bin/neurogenic-appliance
Restart=on-failure
RestartSec=10
TimeoutStopSec=20
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
